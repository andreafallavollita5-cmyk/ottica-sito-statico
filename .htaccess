# ==========================================================================
# Ottica Demo — redirect 301 dal sito WordPress precedente
# Generato automaticamente. Non modificare a mano: rigenerare con redirects.mjs
# ==========================================================================

# il sito è statico: la home è index.html, anche se resta un vecchio index.php
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# forza https e www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.example.com/$1 [R=301,L]

# il vecchio WordPress resta sul server ma è spento: 410 Gone
RewriteRule ^(wp-admin|wp-content|wp-includes|vecchio-wordpress)(/|$) - [G,L]
RewriteRule ^(index\.php|ver\.php|xmlrpc\.php|wp-[^/]+\.php|readme\.html|license\.txt|llms\.txt)$ - [G,L]

# --- redirect specifici (i più lunghi per primi) ---
# un solo salto, barra finale facoltativa, destinazione https assoluta (Aruba è dietro un proxy)

# contenuto trasferito
RewriteRule ^2022/03/06/miopia-che-cosa-e-come-si-manifesta-fattori-di-rischio-come-si-puo-gestire(/.*)?$ https://www.example.com/blog/miopia-bambini-come-rallentarla/ [R=301,L]
# contenuto trasferito
RewriteRule ^2022/03/07/lenti-progressive-e-lenti-office-pregi-qualita-e-vantaggi-di-utilizzo(/.*)?$ https://www.example.com/blog/lenti-progressive-come-sceglierle/ [R=301,L]
